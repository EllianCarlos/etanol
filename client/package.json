{
  "name": "kotlin-lsp-client",
  "displayName": "Kotlin LSP Client",
  "description": "VS Code client for Kotlin LSP written in Rust",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.60.0"
  },
  "scripts": {
    "compile": "tsc",
    "package": "vsce package",
    "test": "mocha"
  },
  "main": "./dist/extension.js",
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "activationEvents": [
    "onLanguage:kotlin"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kotlin",
        "extensions": [
          ".kt",
          ".kts"
        ],
        "aliases": [
          "Kotlin",
          "kotlin"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "Kotlin LSP",
      "properties": {
        "kotlinLsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the etanol server binary. Leave empty to use the dev-mode default (../target/release/etanol relative to the extension)."
        }
      }
    }
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.11",
    "@types/vscode": "^1.60.0",
    "mocha": "^10.7.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
